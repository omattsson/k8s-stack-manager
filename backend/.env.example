# Application Configuration
APP_NAME=application
APP_ENV=development
APP_DEBUG=true

# Database Configuration
# Use 'db' as host when running in Docker Compose, 'localhost' for local dev
DB_HOST=db
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=apppass
DB_NAME=app
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# Server Configuration
SERVER_HOST=0.0.0.0
PORT=8081
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=30s

# Logging Configuration (debug, info, warn or error)
# The SQL statements of APP_DEBUG=true need LOG_LEVEL=debug (#653).
LOG_LEVEL=info

# Session Store (token blocklist + OIDC state persistence)
SESSION_STORE=mysql

# Swagger UI at /swagger/ (development only)
ENABLE_SWAGGER=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Deployment Configuration
HELM_BINARY=helm
KUBECONFIG_PATH=
# Local development only: the kubeconfig of a cluster with use_in_cluster when
# the backend does not run in a pod. Empty = such a cluster is unreachable.
# In Docker Compose it is a path in the container (make dev-k8s mounts
# ~/.kube at /root/.kube, so use /root/.kube/config).
IN_CLUSTER_FALLBACK_KUBECONFIG=
DEPLOYMENT_TIMEOUT=10m
MAX_CONCURRENT_DEPLOYS=5
# Client-side request limit of each cluster client (requests per second, burst).
K8S_CLIENT_QPS=50
K8S_CLIENT_BURST=100
# Extra labels on every stack namespace (comma-separated key=value pairs), in
# addition to managed-by=k8s-stack-manager. Empty = no extra labels.
# Example: pod-security.kubernetes.io/enforce=baseline,pod-security.kubernetes.io/warn=restricted
NAMESPACE_LABELS=

# GitHub branch discovery (optional)
# Tokenless public mode: leave both values empty (lower GitHub API rate limits).
# GITHUB_TOKEN=
# GITHUB_ALLOWED_REPOSITORIES=
# Authenticated mode: use a fine-grained PAT and exact comma-separated owner/repo entries.
# GITHUB_TOKEN=
# GITHUB_ALLOWED_REPOSITORIES=example-org/api,example-org/web
# Fail closed: a non-empty GITHUB_TOKEN requires a non-empty allowlist.

# GitLab branch discovery (optional)
# Absolute HTTP(S) origin only (scheme + hostname, optional port); no credentials,
# query, fragment, or path such as /api/v4. Whitespace and a trailing slash are normalized.
# GITLAB_BASE_URL=https://gitlab.example.com:8443
