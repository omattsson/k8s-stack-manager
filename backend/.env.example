# Application Configuration
APP_NAME=application
APP_ENV=development
APP_DEBUG=true

# Database Configuration
# Use 'db' as host when running in Docker Compose, 'localhost' for local dev
DB_HOST=db
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=apppass
DB_NAME=app
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# Server Configuration
SERVER_HOST=0.0.0.0
PORT=8081
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=30s

# Logging Configuration (debug, info, warn or error)
LOG_LEVEL=info

# Session Store (token blocklist + OIDC state persistence)
SESSION_STORE=mysql

# Swagger UI at /swagger/ (development only)
ENABLE_SWAGGER=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Deployment Configuration
HELM_BINARY=helm
KUBECONFIG_PATH=
# Local development only: the kubeconfig of a cluster with use_in_cluster when
# the backend does not run in a pod. Empty = such a cluster is unreachable.
# In Docker Compose it is a path in the container (make dev-k8s mounts
# ~/.kube at /root/.kube, so use /root/.kube/config).
IN_CLUSTER_FALLBACK_KUBECONFIG=
DEPLOYMENT_TIMEOUT=10m
MAX_CONCURRENT_DEPLOYS=5
# Extra labels on every stack namespace (comma-separated key=value pairs), in
# addition to managed-by=k8s-stack-manager. Empty = no extra labels.
# Example: pod-security.kubernetes.io/enforce=baseline,pod-security.kubernetes.io/warn=restricted
NAMESPACE_LABELS=
