{
  "actions": [
    {
      "name": "e2e-echo",
      "label": "E2E echo",
      "description": "Sends the parameters to the e2e stub, which returns them.",
      "confirm": "This runs the e2e echo action.",
      "url": "http://127.0.0.1:18090/actions/echo",
      "secret_env": "E2E_ACTION_SECRET",
      "timeout_seconds": 10,
      "parameters": [
        { "name": "target", "label": "Target", "type": "string", "required": true, "description": "Any text." },
        { "name": "dry_run", "label": "Dry run", "type": "bool", "default": true },
        { "name": "mode", "label": "Mode", "type": "enum", "options": ["fast", "full"], "default": "fast", "required": true },
        { "name": "token", "label": "Token", "type": "string", "sensitive": true, "description": "Not stored in the run history." }
      ]
    },
    {
      "name": "e2e-job",
      "label": "E2E job",
      "description": "Starts a job with a log on the e2e stub.",
      "url": "http://127.0.0.1:18090/actions/job",
      "log_path": "/jobs/{job_id}/log",
      "secret_env": "E2E_ACTION_SECRET",
      "timeout_seconds": 10
    },
    {
      "name": "e2e-redirect",
      "label": "E2E redirect",
      "description": "The e2e stub answers 302.",
      "url": "http://127.0.0.1:18090/actions/redirect",
      "timeout_seconds": 10
    },
    {
      "name": "e2e-team-a",
      "label": "E2E team A",
      "description": "Only for stacks of templates in the category e2e-team-a.",
      "url": "http://127.0.0.1:18090/actions/echo",
      "timeout_seconds": 10,
      "applies_to": { "template_categories": ["e2e-team-a"] }
    },
    {
      "name": "e2e-team-b",
      "label": "E2E team B",
      "description": "Only for stacks of templates in the category e2e-team-b.",
      "url": "http://127.0.0.1:18090/actions/echo",
      "timeout_seconds": 10,
      "applies_to": { "template_categories": ["e2e-team-b"] }
    },
    {
      "name": "refresh-db-postgres",
      "label": "Refresh database",
      "description": "Postgres extension, only for stacks of the category e2e-postgres-team.",
      "url": "http://127.0.0.1:18090/ext/postgres/actions/refresh-db",
      "timeout_seconds": 10,
      "applies_to": { "template_categories": ["e2e-postgres-team"] }
    },
    {
      "name": "refresh-db-mysql",
      "label": "Refresh database",
      "description": "MySQL extension, only for stacks of the category e2e-mysql-team.",
      "url": "http://127.0.0.1:18090/ext/mysql/actions/refresh-db",
      "timeout_seconds": 10,
      "applies_to": { "template_categories": ["e2e-mysql-team"] }
    }
  ],
  "subscriptions": [
    {
      "name": "e2e-postgres-created",
      "events": ["post-instance-create"],
      "url": "http://127.0.0.1:18090/ext/postgres/hooks/event",
      "timeout_seconds": 5,
      "failure_policy": "ignore",
      "applies_to": { "template_categories": ["e2e-postgres-team"] }
    },
    {
      "name": "e2e-mysql-created",
      "events": ["post-instance-create"],
      "url": "http://127.0.0.1:18090/ext/mysql/hooks/event",
      "timeout_seconds": 5,
      "failure_policy": "ignore",
      "applies_to": { "template_categories": ["e2e-mysql-team"] }
    }
  ]
}
