{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(npm ci:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx playwright:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(go get:*)",
      "Bash(go build:*)",
      "Bash(go mod:*)",
      "Bash(go test:*)",
      "Bash(go tool:*)",
      "Bash(go vet:*)",
      "Bash(docker build:*)",
      "Bash(gofmt:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh api:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(npm install:*)",
      "Bash(make helm-install:*)",
      "Bash(make helm-upgrade:*)",
      "Bash(make helm-uninstall:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in */backend/docs/swagger.json|*/backend/docs/swagger.yaml|*/backend/docs/docs.go) echo 'Generated file: edit the swag annotations and run make docs.' >&2; exit 2;; */helm/*/values.schema.json) echo 'Generated file: edit values.yaml and run make helm-schema.' >&2; exit 2;; esac",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.go) gofmt -w \"$f\";; */frontend/src/*.ts|*/frontend/src/*.tsx) (cd \"$CLAUDE_PROJECT_DIR/frontend\" && npx --no-install eslint --fix \"$f\" >/dev/null 2>&1) || true;; esac",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
